# Port, unter dem WordPress auf diesem Host lauscht
WP_PORT=8612

# Adresse, unter der die Testinstanz aufgerufen wird - nur für die Ausgaben von bin/dev-setup.sh.
# WordPress selbst richtet sich zur Laufzeit nach dem Host-Header.
# Ohne Reverse Proxy einfach weglassen, dann gilt http://localhost:${WP_PORT}
# WP_URL=https://wordpress.example.com
